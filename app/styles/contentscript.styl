#allMachineDataList
  background-color: #000
  padding: 30px 0

  .machineData
    color: #fff
    .machineNumber
      font-size: 30px
    .infoWrap
      .wrap
        font-size: 0
        .bigGraph
          display: inline-block
          vertical-align: top
          img
            width: 420px
            height: auto
        .tableWrap
          color #000
          vertical-align: top
          display: inline-block
          font-size: 13px
          width: 420px
          #dedama_ki
            &nd_table
              margin: 0
          td
            padding: 0
      .smallGraphs
        counter-reset: days -1
        li
          counter-increment: days;
          display: inline-block
          padding: 2px
          &:before
            content: counter(days) '日前';
            display: block
            font-size: 15px
            font-weight: bold

          &:first-child:before
            content '本日'

          img
            width: 100px
            height: auto
