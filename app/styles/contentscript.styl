body
  user-select: auto !important
  vendor('user-drag', auto) !important

.buccoHall
  background-color: #fff
  padding: 30px 0

  &__info
    &__title
      font-size: 25px
      font-weight: bold

    &__sales
      counter-reset: days -1
      &__sale
        clearfix()
        counter-increment: days;
        font-size: 18px
        text-align: right
        width: 200px
        &:before
          float: left
          content: counter(days) '日前';
          display: inline-block
          font-size: 15px
          padding: 0 5px
          box-sizing border-box
          width: 60px

        &:first-child:before
          content '当日'
        &:nth-child(2):before
          content '前日'

  &__chartCoinRate
    size 100% 420px

  &__content
      display: block

  &__status
      display: block

.buccoMachine
  &.corner
    relative()
    &:after
      absolute(right 10px top 30px)
      content: '角'
      transform rotate(30deg)
      border 5px solid #ff0000
      border-radius 50%
      font-size: 50px
      font-weight: bold
      color #ff0000
      padding: 10px
      $offset = 30px;
      $border = 7px;
      box-shadow: 0 $offset 0 0 #fff, $offset 0 0 0 #fff, (- $offset) 0 0 0 #fff, 0 (- $offset) 0 0 #fff,
        0 $offset 0 $border #ff0000, $offset 0 0 $border #ff0000, (- $offset) 0 0 $border #ff0000, 0 (- $offset) 0 $border #ff0000


  &__header
    &__number
      font-size: 100px
      font-weight: bold
      display: inline-block

    &__setting
      display: inline-block

      &__key
        font-size: 15px
      &__sale
      &__coinRate
        font-size: 25px
        font-weight: bold


  &__info
    &__bigGraph img
      size auto

    &__smallGraphs
      counter-reset: days -1
      font-size: 0
      display: flex;
      flex-direction: row-reverse;
      li
        counter-increment: days;
        display: inline-block
        width:12.5%
        img
          width: 100%
          height: auto
        &:before
          content: counter(days) '日前';
          display: block
          font-size: 15px
          font-weight: bold
          text-align: center
          padding: 20px 0 5px

        &:first-child:before
          content '当日'
        &:nth-child(2):before
          content '前日'
    &__detail
      &#dedama_kind_table
        margin: 0

    &__mixChart
    &__bigChart
    &__regChart
      size 100% 0

.buccoGraph
  &.shrimp
