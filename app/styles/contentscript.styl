body
  user-select: auto !important
  vendor('user-drag', auto) !important

.startButton
  display: inline-block
  text-decoration: none
  background: #ff8181
  color: #FFF
  width: 100px
  height: 100px
  line-height: 100px
  border-radius: 50%
  text-align: center
  font-weight: bold
  font-size: 23px
  vertical-align: middle
  overflow: hidden
  box-shadow: 0 2px 2px rgba(0, 0, 0, 0.29)
  border-bottom: solid 3px #bd6565
  transition: .4s

.ultraHall
  padding: 20px 0
  &__control
    text-align: center

  &__contents
    .ultraEquipment__islands
      display: none
      &.show
        display: block

.ultraEquipment
  padding: 20px 0
  text-align: left

  &__info
    &__name
      font-size: 50px
      font-weight: bold
      text-align: center
      background-color: #dea
      padding: 25px 0 20px
      border-radius: 20px
      border: 5px solid #666

    &__totalInfo
      font-size: 0
      &__day
        &__item
          font-size: 15px
          display: inline-block
          width: 50%

  &__control
    text-align: center

  &__islands
    .ultraIsland
      padding: 20px 0

      &:nth-child(n + 2)
        border-top: 10px solid #999

.ultraIsland
  font-size: 0
  &__info
    &__item
      display: inline-block
      font-size: 20px
      width: 50%

      &__day
        display: inline-block

      &__number
        display: inline-block
        text-align: right
        width: 120px

  &__left
  &__right
    display: inline-block
    vertical-align: top
    width: 50%

  .ultraMachine
    display: inline-block
    width: 100%
    padding: 10px 5px
    box-sizing: border-box

    &__data__dayDataList__day
      width: 25%

.ultraMachine
  padding-bottom: 50px

  .v-enter-active, v-leave-active
    transition-duration 0.5s
  .v-enter, .v-leave-to
    opacity: 0
  .v-leave-active
    absolute()

  &__status
    text-align: center
    font-size: 20px
    font-weight: bold

  &__info
    &__number
      font-size: 40px
      font-weight: bold
      display: inline-block
      width: 140px
      vertical-align: middle
    &__totalCoin
      font-size: 20px
      display: inline-block
      vertical-align: middle

  &__data
    &__totalGraph
      img
        width: 100%
        height: auto

    &__dayDataList
      display: block
      direction: rtl
      unicode-bidi: bidi-override
      white-space: nowrap
      overflow-x auto
      overflow-y hidden
      &__day
        display: inline-block
        width: 12.5%
        direction: ltr

        &__number
          text-align: center
          font-size: 15px
          padding: 5px 0

        &__smallGraph
          img
            width: 100%

        &__icons
          font-size: 0
          text-align: center
          height: 25px
          &__icon
            display: inline-block
            size 25px
            margin: 0 2px
            border-radius 50%
            border 1px solid #000
            box-sizing border-box

            &.shrimp
              background-image: url("data:image/png;base64,")
            &.baby
              background-image: url("data:image/png;base64,")
            &.hart
              background-image: url("data:image/png;base64,")

        &__item
          padding: 2px 5px
          font-size: 12px
          text-align: right

          &.best
            background-color: #5b54ff
          &.better
            background-color: #9391ff
          &.good
            background-color: #67e4ff
          &.bad
            background-color: #fffc4a
          &.worse
            background-color: #ffa8a3
          &.worst
            background-color: #ff041d

          span
            display: inline-block
            width: 45px
            float: left;
            vertical-align: middle
            text-align: left;
            font-size: 14px
            font-weight: bold
