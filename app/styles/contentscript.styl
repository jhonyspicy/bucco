.buccoHall
  background-color: #fff
  padding: 30px 0

  &__content
      display: block

  &__status
      display: block

.buccoMachine
  &__header
    &__number
      font-size: 100px
      font-weight: bold

  &__info
    &__bigGraph img
      size 100% auto

    &__smallGraphs
      counter-reset: days -1
      font-size: 0
      display: flex;
      flex-direction: row-reverse;
      li
        counter-increment: days;
        display: inline-block
        width:12.5%
        img
          width: 100%
          height: auto
        &:before
          content: counter(days) '日前';
          display: block
          font-size: 15px
          font-weight: bold
          text-align: center
          padding: 20px 0 5px

        &:first-child:before
          content '当日'
        &:nth-child(2):before
          content '前日'
    &__detail
      &#dedama_kind_table
        margin: 0

    &__mixChart
    &__bigChart
    &__regChart
      size 100% 0

