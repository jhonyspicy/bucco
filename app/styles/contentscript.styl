body
  user-select: auto !important
  vendor('user-drag', auto) !important

.buccoHall
  background-color: #fff
  padding: 30px 0

  &__info
    &__title
      font-size: 25px
      font-weight: bold

    &__sales
      counter-reset: days -1
      &__sale
        clearfix()
        counter-increment: days;
        font-size: 18px
        text-align: right
        width: 200px
        &:before
          float: left
          content: counter(days) '日前';
          display: inline-block
          font-size: 15px
          padding: 0 5px
          box-sizing border-box
          width: 60px

        &:first-child:before
          content '当日'
        &:nth-child(2):before
          content '前日'

  &__chartCoinRate
    size 100% 420px

  &__content
      display: block

  &__status
      display: block

.buccoMachine
  &__header
    &__number
      font-size: 100px
      font-weight: bold
      display: inline-block

    &__setting
      display: inline-block

      &__key
        font-size: 15px
      &__level
      &__coinRate
        font-size: 25px
        font-weight: bold


  &__info
    &__bigGraph img
      size 100% auto

    &__smallGraphs
      counter-reset: days -1
      font-size: 0
      display: flex;
      flex-direction: row-reverse;
      li
        counter-increment: days;
        display: inline-block
        width:12.5%
        img
          width: 100%
          height: auto
        &:before
          content: counter(days) '日前';
          display: block
          font-size: 15px
          font-weight: bold
          text-align: center
          padding: 20px 0 5px

        &:first-child:before
          content '当日'
        &:nth-child(2):before
          content '前日'
    &__detail
      &#dedama_kind_table
        margin: 0

    &__mixChart
    &__bigChart
    &__regChart
      size 100% 0

.buccoGraph
  &.coinRate40
    background-color: #7363ff
  &.coinRate39
    background-color: #7363ff
  &.coinRate38
    background-color: #7363ff
  &.coinRate37
    background-color: #00FF00
  &.coinRate36
    background-color: #00FF00
  &.coinRate35
    background-color: #FFBEDA
  &.coinRate34
    background-color: #FF0000
  &.coinRate33
    background-color: #FF0000
  &.coinRate00
    background-color: #FF0000
  &__info
    &__coinRate
    &__nowCoin
    &__min
    &__max
    &__rangePlus
    &__rangeMinus
      display: block
      padding: 5px 0 0
      &__key
        display: inline-block
        padding: 5px 0
        font-size: 11px
      &__value
        display: inline-block
        font-size: 15px
        font-weight: bold
